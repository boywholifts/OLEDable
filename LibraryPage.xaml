<UserControl x:Class="HydroShiftRecorder.LibraryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Page">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>
    <!-- a whole tile is one button; hovering rings the thumbnail in the accent colour -->
    <Style x:Key="TileBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <ContentPresenter/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="36,4,36,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Library" FontSize="26" FontWeight="Bold"/>
        <Button x:Name="FolderBtn" Style="{StaticResource GhostBtn}" Height="30" Padding="0" HorizontalAlignment="Left" Margin="-2,4,0,0"
                ToolTip="Choose which folder the library shows (new videos are saved here too)">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Icon}" Width="16" Height="16" Data="M3,18 V6.5 C3,5.7 3.7,5 4.5,5 H8.6 L10.8,7 H19.5 C20.3,7 21,7.7 21,8.5 V18 C21,18.8 20.3,19.5 19.5,19.5 H4.5 C3.7,19.5 3,18.8 3,18 Z"/>
            <TextBlock x:Name="FolderText" Margin="8,0,0,0" FontSize="13" Foreground="{DynamicResource Sub}" VerticalAlignment="Center" MaxWidth="480" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="Change" Margin="10,0,0,0" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="RecScreenBtn" Style="{StaticResource GhostBtn}" Margin="0,0,6,0" ToolTip="Record what's on one of your screens">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="10" Height="10" Fill="#FFFF4D5E" VerticalAlignment="Center"/>
            <TextBlock Text="Record screen" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button x:Name="ImportBtn" Style="{StaticResource PrimaryPill}" ToolTip="Open a video or image (you can also drop one on the window)">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Icon}" Width="16" Height="16" Data="M12,4 V15 M7,10 L12,15 L17,10 M5,20 H19"/>
            <TextBlock Text="Import" Margin="8,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- filters -->
    <DockPanel Grid.Row="1" Margin="0,20,0,0" LastChildFill="False">
      <RadioButton x:Name="FAll" Content="All" GroupName="lf" Style="{StaticResource Chip}" IsChecked="True"/>
      <RadioButton x:Name="FRec" Content="Recordings" GroupName="lf" Style="{StaticResource Chip}"/>
      <RadioButton x:Name="FConv" Content="Converted" GroupName="lf" Style="{StaticResource Chip}"/>
      <RadioButton x:Name="FTodo" Content="Originals" GroupName="lf" Style="{StaticResource Chip}" ToolTip="Source videos the app hasn't made"/>
      <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{DynamicResource Sub}" FontSize="13" VerticalAlignment="Center"/>
    </DockPanel>

    <!-- grid of videos -->
    <ScrollViewer x:Name="Scroller" Grid.Row="2" Margin="0,22,-22,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <ItemsControl x:Name="Tiles" Margin="0,0,0,24">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button x:Name="TileButton" Style="{StaticResource TileBtn}" Width="{Binding TileW, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,22,26" Tag="{Binding}"
                    Click="Tile_Click" MouseRightButtonUp="Tile_RightClick">
              <Grid>
                <!-- the "add" tile -->
                <Border Visibility="{Binding IsAddTile, Converter={StaticResource Vis}}" Height="{Binding TileH, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CornerRadius="12" BorderThickness="1.5" BorderBrush="{DynamicResource Dashed}" Background="Transparent">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Raised}">
                      <Path Data="M12,5 V19 M5,12 H19" Stroke="{DynamicResource Text}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                            Width="16" Height="16" Stretch="Uniform"/>
                    </Border>
                    <TextBlock Text="Import, or drop a video or image here" Foreground="{DynamicResource Sub}" FontSize="13" Margin="0,10,0,0"/>
                  </StackPanel>
                </Border>
                <!-- a video -->
                <StackPanel Visibility="{Binding IsNormal, Converter={StaticResource Vis}}">
                  <Grid Height="{Binding TileH, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Border x:Name="Ring" CornerRadius="14" Margin="-3" BorderThickness="2" BorderBrush="Transparent"/>
                    <Border CornerRadius="12" Background="Black"/>
                    <Border CornerRadius="12" RenderOptions.BitmapScalingMode="HighQuality">
                      <Border.Background><ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/></Border.Background>
                    </Border>
                  </Grid>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Sub}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Grid>
            </Button>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileButton}" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- empty folder -->
    <StackPanel x:Name="Empty" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,80">
      <TextBlock Text="Nothing here yet" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock Text="Pick a wallpaper from Wallpaper Engine, or import a video or image." Foreground="{DynamicResource Sub}"
                 HorizontalAlignment="Center" Margin="0,8,0,18"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button x:Name="EmptyImport" Content="Import" Style="{StaticResource Pill}" Margin="0,0,10,0"/>
        <Button x:Name="EmptyRecord" Content="Browse Wallpaper Engine" Style="{StaticResource PrimaryPill}"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
