<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HydroShiftRecorder</AssemblyName>
    <RootNamespace>HydroShiftRecorder</RootNamespace>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.2.0</Version>
    <Product>HydroShift Recorder</Product>
    <AssemblyTitle>HydroShift Recorder</AssemblyTitle>
    <Description>Records and converts seamless loops for the Lian Li HydroShift II OLED Curved display</Description>
    <Copyright>Open source</Copyright>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- lets the project build without the .NET Framework targeting pack installed -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- replaced by the editor page -->
    <Page Remove="TunerWindow.xaml" />
    <Compile Remove="TunerWindow.xaml.cs" />
  </ItemGroup>

</Project>
