<Window x:Class="HydroShiftRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OLEDable" Width="1280" Height="800" MinWidth="1000" MinHeight="660"
        WindowStartupLocation="CenterScreen" AllowDrop="True" ResizeMode="CanResize"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        Icon="assets/icon.ico" UseLayoutRounding="True">
  <!-- a normal resizable window (Windows snap, resize, shadow) with the app's own slim title bar -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- ========== sidebar ========== -->
    <Border Grid.Column="0" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,12,14,16" LastChildFill="False">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,2,0,24" Height="28">
          <Canvas Width="28" Height="28">
            <Rectangle Canvas.Left="1" Canvas.Top="7" Width="26" Height="14" RadiusX="7" RadiusY="7" Stroke="{DynamicResource Accent}" StrokeThickness="2"/>
            <Path Data="M7,14 C10,9 13,19 16,14 S21,10 22,14" Stroke="#FFFF4D5E" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Canvas>
          <TextBlock Text="OLEDable" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>

        <RadioButton x:Name="NavLibrary" DockPanel.Dock="Top" GroupName="nav" Style="{StaticResource NavItem}" Margin="0,0,0,4">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Icon}" Data="M4.5,4 H9.5 A1.5,1.5 0 0 1 11,5.5 V9.5 A1.5,1.5 0 0 1 9.5,11 H4.5 A1.5,1.5 0 0 1 3,9.5 V5.5 A1.5,1.5 0 0 1 4.5,4 Z M14.5,4 H19.5 A1.5,1.5 0 0 1 21,5.5 V9.5 A1.5,1.5 0 0 1 19.5,11 H14.5 A1.5,1.5 0 0 1 13,9.5 V5.5 A1.5,1.5 0 0 1 14.5,4 Z M4.5,13 H9.5 A1.5,1.5 0 0 1 11,14.5 V18.5 A1.5,1.5 0 0 1 9.5,20 H4.5 A1.5,1.5 0 0 1 3,18.5 V14.5 A1.5,1.5 0 0 1 4.5,13 Z M14.5,13 H19.5 A1.5,1.5 0 0 1 21,14.5 V18.5 A1.5,1.5 0 0 1 19.5,20 H14.5 A1.5,1.5 0 0 1 13,18.5 V14.5 A1.5,1.5 0 0 1 14.5,13 Z"/>
            <TextBlock Text="Library" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </RadioButton>
        <!-- the video being edited, so you can leave the editor and come back to it -->
        <RadioButton x:Name="NavEditing" DockPanel.Dock="Top" GroupName="nav" Style="{StaticResource NavItem}" Margin="0,0,0,4"
                     Visibility="Collapsed" ToolTip="Back to the video you're editing">
          <DockPanel LastChildFill="True">
            <Button x:Name="EditCloseBtn" DockPanel.Dock="Right" Width="22" Height="22" Margin="6,0,-4,0" Cursor="Hand" Focusable="False"
                    ToolTip="Close this edit" Foreground="{DynamicResource Sub}">
              <Button.Template><ControlTemplate TargetType="Button">
                <Border x:Name="cb" CornerRadius="6" Background="Transparent">
                  <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cb" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate></Button.Template>
            </Button>
            <Path DockPanel.Dock="Left" Style="{StaticResource Icon}" Data="M4,20 L4.8,16.2 L15.6,5.4 A2,2 0 0 1 18.6,8.4 L7.8,19.2 Z M13.8,7.2 L16.8,10.2"/>
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Editing" FontSize="11" Foreground="{DynamicResource Sub}" FontWeight="Normal"/>
              <TextBlock x:Name="EditingText" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DockPanel>
        </RadioButton>
        <RadioButton x:Name="NavWe" DockPanel.Dock="Top" GroupName="nav" Style="{StaticResource NavItem}" Margin="0,0,0,4">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Icon}" Data="M4.5,4.5 H19.5 A1.5,1.5 0 0 1 21,6 V15 A1.5,1.5 0 0 1 19.5,16.5 H4.5 A1.5,1.5 0 0 1 3,15 V6 A1.5,1.5 0 0 1 4.5,4.5 Z M9,20 H15 M12,16.5 V20 M6.5,13.5 L10,9.5 L12.5,12 L14.5,10 L17.5,13.5"/>
            <TextBlock Text="Wallpaper Engine" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavSettings" DockPanel.Dock="Top" GroupName="nav" Style="{StaticResource NavItem}">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Icon}" Data="M4,7 H14 M18,7 H20 M4,17 H8 M12,17 H20 M14,7 A2,2 0 1 0 18,7 A2,2 0 1 0 14,7 Z M8,17 A2,2 0 1 0 12,17 A2,2 0 1 0 8,17 Z"/>
            <TextBlock Text="Settings" Margin="12,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </RadioButton>

        <!-- a warning at the bottom, shown only when ffmpeg is missing -->
        <Border x:Name="DisplayCard" DockPanel.Dock="Bottom" CornerRadius="12" Padding="14,12" Background="{DynamicResource Raised}"
                BorderBrush="{DynamicResource Line}" BorderThickness="1" Visibility="Collapsed">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="DisplayDot" Width="8" Height="8" Fill="#FF8E8E93" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="DisplayText" Text="Looking for HydroShift…" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
            <TextBlock x:Name="DisplaySub" Text="" FontSize="12" Foreground="{DynamicResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>

        <!-- update available, above the job and display cards -->
        <Border x:Name="UpdateCard" DockPanel.Dock="Bottom" CornerRadius="12" Padding="14,12" Margin="0,0,0,10" Visibility="Collapsed"
                Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Accent}" BorderThickness="1">
          <StackPanel>
            <DockPanel>
              <Button x:Name="UpdateDismiss" DockPanel.Dock="Right" Width="20" Height="20" Margin="6,-2,-4,0" Cursor="Hand" Focusable="False"
                      ToolTip="Skip this version" Foreground="{DynamicResource Sub}" VerticalAlignment="Top">
                <Button.Template><ControlTemplate TargetType="Button">
                  <Border x:Name="cb" CornerRadius="6" Background="Transparent">
                    <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cb" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Button.Template>
              </Button>
              <TextBlock x:Name="UpdateTitle" Text="Update available" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock x:Name="UpdateText" FontSize="12" Foreground="{DynamicResource Sub}" Margin="0,4,0,10" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal">
              <Button x:Name="UpdateNow" Content="Update now" Style="{StaticResource PrimaryPill}" Height="30" Padding="14,0"/>
              <Button x:Name="UpdateNotes" Content="What's new" Style="{StaticResource Link}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- last export finished: click to show the file in Explorer -->
        <Button x:Name="DoneCard" DockPanel.Dock="Bottom" Margin="0,0,0,10" Visibility="Collapsed" Cursor="Hand" Focusable="False" Foreground="{DynamicResource Text}"
                ToolTip="Show the file in its folder">
          <Button.Template><ControlTemplate TargetType="Button">
            <Border x:Name="db" CornerRadius="12" Padding="14,12" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="db" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate></Button.Template>
          <StackPanel>
            <DockPanel>
              <Button x:Name="DoneDismiss" DockPanel.Dock="Right" Width="20" Height="20" Margin="6,-2,-4,0" Cursor="Hand" Focusable="False"
                      ToolTip="Dismiss" Foreground="{DynamicResource Sub}" VerticalAlignment="Top">
                <Button.Template><ControlTemplate TargetType="Button">
                  <Border x:Name="cb" CornerRadius="6" Background="Transparent">
                    <Path Data="M0,0 L8,8 M8,0 L0,8" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cb" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate></Button.Template>
              </Button>
              <Border Width="18" Height="18" CornerRadius="9" Background="{DynamicResource AccentDark}" Margin="0,0,8,0" VerticalAlignment="Center">
                <Path Data="M0,4 L3,7 L8,0" Stroke="White" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock x:Name="DoneTitle" Text="Export finished" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
            <TextBlock x:Name="DoneName" FontSize="12" Foreground="{DynamicResource Text}" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DoneText" FontSize="12" Foreground="{DynamicResource Sub}" Margin="0,2,0,6" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="Show in folder" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentText}"/>
          </StackPanel>
        </Button>

        <!-- running job, above the display card -->
        <Border x:Name="JobCard" DockPanel.Dock="Bottom" CornerRadius="12" Padding="14,12" Margin="0,0,0,10" Visibility="Collapsed"
                Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="JobTitle" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="JobText" FontSize="12" Foreground="{DynamicResource Sub}" Margin="0,4,0,8" TextWrapping="Wrap"/>
            <ProgressBar x:Name="JobProg" Style="{StaticResource Thin}" Minimum="0" Maximum="1"/>
            <Button x:Name="JobCancel" Content="Cancel" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
      </DockPanel>
    </Border>

    <!-- ========== content ========== -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="34"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button x:Name="BtnMin" Style="{StaticResource CaptionBtn}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Minimize">
          <Path Data="M0,0.5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
        </Button>
        <Button x:Name="BtnMax" Style="{StaticResource CaptionBtn}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Maximize">
          <Path x:Name="MaxIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
        </Button>
        <Button x:Name="BtnClose" Style="{StaticResource CloseBtn}" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Close">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1"/>
        </Button>
      </StackPanel>

      <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>

      <!-- toast -->
      <Border x:Name="Toast" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
              CornerRadius="12" Padding="16,10" Background="{DynamicResource ChipOnBg}" Visibility="Collapsed" IsHitTestVisible="False">
        <TextBlock x:Name="ToastText" Foreground="{DynamicResource ChipOnText}" FontSize="13" FontWeight="SemiBold"/>
      </Border>
    </Grid>
  </Grid>
</Window>
