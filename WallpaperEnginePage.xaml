<UserControl x:Class="HydroShiftRecorder.WallpaperEnginePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>
    <Style x:Key="TileBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <ContentPresenter/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- the small action buttons under each wallpaper -->
    <Style x:Key="Act" TargetType="Button" BasedOn="{StaticResource Pill}">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="11,0"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
    <Style x:Key="ActMain" TargetType="Button" BasedOn="{StaticResource PrimaryPill}">
      <Setter Property="Height" Value="30"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Margin" Value="0,0,6,6"/>
      <Setter Property="Focusable" Value="False"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="36,4,36,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <DockPanel>
      <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource Pill}" VerticalAlignment="Center"
              ToolTip="Look for new downloads"/>
      <StackPanel>
        <TextBlock Text="Wallpaper Engine" FontSize="26" FontWeight="Bold"/>
        <TextBlock x:Name="SubText" Foreground="{DynamicResource Sub}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Your downloaded wallpapers. Edit a video, or bring a scene in by recording it with its animation, taking its still image, or using the video inside it when it has one. Wallpaper Engine's own files are never changed."/>
      </StackPanel>
    </DockPanel>

    <!-- search + filters -->
    <DockPanel Grid.Row="1" Margin="0,20,0,0" LastChildFill="False">
      <RadioButton x:Name="FAll" Content="All" GroupName="wf" Style="{StaticResource Chip}" IsChecked="True"/>
      <RadioButton x:Name="FVideo" Content="Videos" GroupName="wf" Style="{StaticResource Chip}"/>
      <RadioButton x:Name="FScene" Content="Scenes" GroupName="wf" Style="{StaticResource Chip}"/>
      <RadioButton x:Name="FOther" Content="Web &amp; other" GroupName="wf" Style="{StaticResource Chip}"/>
      <Grid DockPanel.Dock="Right" Width="260" Margin="12,0,0,0">
        <TextBox x:Name="SearchBox" Style="{StaticResource Field}"/>
        <TextBlock x:Name="SearchPh" Text="Search" Foreground="{DynamicResource Sub}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{DynamicResource Sub}" FontSize="13" VerticalAlignment="Center"/>
    </DockPanel>

    <ScrollViewer x:Name="Scroller" Grid.Row="2" Margin="0,22,-22,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <ItemsControl x:Name="Tiles" Margin="0,0,0,24">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel x:Name="Tile" Width="{Binding TileW, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,22,26">
              <!-- clicking the picture does the main action: edit a video, record a scene or web wallpaper -->
              <Button x:Name="TileButton" Style="{StaticResource TileBtn}" Tag="{Binding}" Click="Main_Click" ToolTip="{Binding MainTip}">
                <Grid Height="{Binding TileH, RelativeSource={RelativeSource AncestorType=UserControl}}">
                  <Border x:Name="Ring" CornerRadius="14" Margin="-3" BorderThickness="2" BorderBrush="Transparent"/>
                  <Border CornerRadius="12" Background="Black"/>
                  <Border CornerRadius="12" RenderOptions.BitmapScalingMode="HighQuality">
                    <Border.Background><ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/></Border.Background>
                  </Border>
                  <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" CornerRadius="6" Padding="8,3" Background="#B8000000">
                    <TextBlock Text="{Binding KindLabel}" Foreground="#FFF2F2F5" FontSize="11" FontWeight="SemiBold"/>
                  </Border>
                </Grid>
              </Button>
              <DockPanel Margin="0,10,0,0">
                <Button DockPanel.Dock="Right" Content="Folder" Style="{StaticResource Link}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                        Tag="{Binding}" Click="Folder_Click" ToolTip="Show this wallpaper's files in Explorer"/>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
              </DockPanel>
              <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Sub}" FontSize="12" Margin="0,3,0,10" TextTrimming="CharacterEllipsis"/>
              <WrapPanel>
                <Button Content="Edit" Style="{StaticResource ActMain}" Tag="{Binding}" Click="Edit_Click"
                        Visibility="{Binding IsVideo, Converter={StaticResource Vis}}"
                        ToolTip="Copies the video into your library and opens it in the editor"/>
                <Button Content="Record" Style="{StaticResource ActMain}" Tag="{Binding}" Click="Record_Click"
                        Visibility="{Binding CanRecord, Converter={StaticResource Vis}}"
                        ToolTip="Wallpaper Engine plays it in a window at the size you pick, and the app records it with its animation"/>
                <Button Content="Still image" Style="{StaticResource Act}" Tag="{Binding}" Click="Still_Click"
                        Visibility="{Binding IsScene, Converter={StaticResource Vis}}"
                        ToolTip="The scene's background picture, without its animation (instant)"/>
                <Button Content="Use its video" Style="{StaticResource Act}" Tag="{Binding}" Click="VideoLayer_Click"
                        Visibility="{Binding HasVideo, Converter={StaticResource Vis}}"
                        ToolTip="This scene plays a video. Take that video as it is and open it in the editor (instant, full quality)."/>
                <TextBlock Text="Can't be imported" Foreground="{DynamicResource Sub}" FontSize="12" Margin="0,6,0,6"
                           Visibility="{Binding Unsupported, Converter={StaticResource Vis}}"/>
              </WrapPanel>
            </StackPanel>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileButton}" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding Unsupported}" Value="True">
                <Setter TargetName="TileButton" Property="Cursor" Value="Arrow"/>
                <Setter TargetName="TileButton" Property="IsHitTestVisible" Value="False"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel x:Name="Empty" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,80">
      <TextBlock x:Name="EmptyTitle" Text="No Wallpaper Engine wallpapers found" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock x:Name="EmptyText" Text="Subscribe to wallpapers in Wallpaper Engine (Steam Workshop) and they'll show up here."
                 Foreground="{DynamicResource Sub}" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
    </StackPanel>
  </Grid>
</UserControl>
