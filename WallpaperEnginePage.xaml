<UserControl x:Class="HydroShiftRecorder.WallpaperEnginePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Vis"/>
    <Style x:Key="TileBtn" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <ContentPresenter/>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>

  <Grid Margin="36,4,36,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- header: the selected wallpaper's actions on the right, like the Library's buttons -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,24,0">
        <TextBlock Text="Wallpaper Engine" FontSize="26" FontWeight="Bold"/>
        <TextBlock x:Name="SubText" Foreground="{DynamicResource Sub}" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"
                   Text="Your downloaded wallpapers. Select one to see what you can do with it (double-click does the main one). Wallpaper Engine's own files are never changed."/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock x:Name="SelHint" Text="Select a wallpaper" Foreground="{DynamicResource Sub}" FontSize="13" VerticalAlignment="Center" Margin="0,0,14,0"/>
        <StackPanel x:Name="SelActions" Orientation="Horizontal" Visibility="Collapsed">
          <TextBlock x:Name="SelNote" Foreground="{DynamicResource Sub}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
          <Button x:Name="FolderBtn" Content="Show in folder" Style="{StaticResource GhostBtn}" Margin="0,0,6,0" ToolTip="Open this wallpaper's files in Explorer"/>
          <Button x:Name="StillBtn" Content="Still image" Style="{StaticResource Pill}" Margin="0,0,10,0"
                  ToolTip="The scene's background picture, without its animation (instant)"/>
          <Button x:Name="UseVideoBtn" Content="Use its video" Style="{StaticResource Pill}" Margin="0,0,10,0"
                  ToolTip="This scene plays a video. Take that video as it is and open it in the editor (instant, full quality)."/>
          <Button x:Name="RecordBtn" Content="Record" Style="{StaticResource PrimaryPill}" Margin="0,0,10,0"
                  ToolTip="Wallpaper Engine plays it in a window at the size you pick, and the app records it with its animation"/>
          <Button x:Name="EditBtn" Content="Edit" Style="{StaticResource PrimaryPill}" Margin="0,0,10,0"
                  ToolTip="Copies the video into your library and opens it in the editor"/>
        </StackPanel>
        <!-- refresh: two arrows looping around a rounded square -->
        <Button x:Name="RefreshBtn" Style="{StaticResource GhostBtn}" Width="40" Padding="0" ToolTip="Refresh: look for new downloads">
          <Viewbox Width="18" Height="18">
            <Canvas x:Name="RefreshIcon" Width="16" Height="16">
              <Path Data="M2,9 L2,7 A3,3 0 0 1 5,4 L13,4" Stroke="{DynamicResource Text}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M10.5,1.5 L13,4 L10.5,6.5" Stroke="{DynamicResource Text}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M14,7 L14,9 A3,3 0 0 1 11,12 L3,12" Stroke="{DynamicResource Text}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              <Path Data="M5.5,9.5 L3,12 L5.5,14.5" Stroke="{DynamicResource Text}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
            </Canvas>
          </Viewbox>
        </Button>
      </StackPanel>
    </Grid>

    <!-- search + filters -->
    <DockPanel Grid.Row="1" Margin="0,20,0,0" LastChildFill="False">
      <RadioButton x:Name="FAll" Content="All" GroupName="wf" Style="{StaticResource Chip}" IsChecked="True"/>
      <RadioButton x:Name="FVideo" Content="Videos" GroupName="wf" Style="{StaticResource Chip}"/>
      <RadioButton x:Name="FScene" Content="Scenes" GroupName="wf" Style="{StaticResource Chip}"/>
      <RadioButton x:Name="FOther" Content="Web &amp; other" GroupName="wf" Style="{StaticResource Chip}"/>
      <Grid DockPanel.Dock="Right" Width="260" Margin="12,0,0,0">
        <TextBox x:Name="SearchBox" Style="{StaticResource Field}"/>
        <TextBlock x:Name="SearchPh" Text="Search" Foreground="{DynamicResource Sub}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
      </Grid>
      <TextBlock x:Name="CountText" DockPanel.Dock="Right" Foreground="{DynamicResource Sub}" FontSize="13" VerticalAlignment="Center"/>
    </DockPanel>

    <ScrollViewer x:Name="Scroller" Grid.Row="2" Margin="0,22,-22,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <ItemsControl x:Name="Tiles" Margin="0,0,0,24">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel x:Name="Tile" Width="{Binding TileW, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="0,0,22,26">
              <!-- click selects (the actions appear at the top right); double-click does the main action -->
              <Button x:Name="TileButton" Style="{StaticResource TileBtn}" Tag="{Binding}" Click="Tile_Click" MouseDoubleClick="Tile_DoubleClick">
                <StackPanel>
                  <Grid Height="{Binding TileH, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Border x:Name="Ring" CornerRadius="14" Margin="-3" BorderThickness="2" BorderBrush="Transparent"/>
                    <Border CornerRadius="12" Background="Black"/>
                    <Border CornerRadius="12" RenderOptions.BitmapScalingMode="HighQuality">
                      <Border.Background><ImageBrush ImageSource="{Binding Thumb}" Stretch="UniformToFill"/></Border.Background>
                    </Border>
                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" CornerRadius="6" Padding="8,3" Background="#B8000000">
                      <TextBlock Text="{Binding KindLabel}" Foreground="#FFF2F2F5" FontSize="11" FontWeight="SemiBold"/>
                    </Border>
                  </Grid>
                  <TextBlock x:Name="NameText" Text="{Binding Name}" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                  <TextBlock Text="{Binding Meta}" Foreground="{DynamicResource Sub}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <DataTemplate.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, ElementName=TileButton}" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Line2}"/>
              </DataTrigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Ring" Property="BorderThickness" Value="3"/>
                <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource AccentText}"/>
              </DataTrigger>
            </DataTemplate.Triggers>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel x:Name="Empty" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,80">
      <TextBlock x:Name="EmptyTitle" Text="No Wallpaper Engine wallpapers found" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock x:Name="EmptyText" Text="Subscribe to wallpapers in Wallpaper Engine (Steam Workshop) and they'll show up here."
                 Foreground="{DynamicResource Sub}" HorizontalAlignment="Center" Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
    </StackPanel>
  </Grid>
</UserControl>
