<Window x:Class="HydroShiftRecorder.TunerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="True black" Width="786" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="#FFF5F5F7"
        UseLayoutRounding="True">

  <Grid Margin="14">
    <Border CornerRadius="16" Background="#FF1C1C1E">
      <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.55" Color="Black"/></Border.Effect>
    </Border>
    <Border CornerRadius="16" Background="#FF1C1C1E" BorderBrush="#22FFFFFF" BorderThickness="1">
      <StackPanel Margin="20,0,20,18">

        <Grid x:Name="TitleBar" Height="44" Background="Transparent">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Ellipse x:Name="BtnClose" Width="12" Height="12" Fill="#FFFF5F57" Cursor="Hand" Margin="0,0,8,0" ToolTip="Cancel"/>
            <Ellipse Width="12" Height="12" Fill="#FF3A3A3C" Margin="0,0,8,0"/>
            <Ellipse Width="12" Height="12" Fill="#FF3A3A3C"/>
          </StackPanel>
          <TextBlock x:Name="TitleText" Text="True black" HorizontalAlignment="Center" VerticalAlignment="Center"
                     FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Sub}"
                     MaxWidth="520" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- before / after: drag anywhere on the picture to move the divider -->
        <Grid x:Name="PreviewHost" Width="716" Height="328" Margin="0,4,0,0" Background="Black" Cursor="SizeWE"
              ToolTip="Drag to compare the original (left) with the OLED version (right)">
          <Grid.Clip><RectangleGeometry Rect="0,0,716,328" RadiusX="12" RadiusY="12"/></Grid.Clip>
          <Image x:Name="OledImg" Width="716" Height="328" Stretch="Fill"/>
          <Image x:Name="OrigImg" Width="716" Height="328" Stretch="Fill"/>
          <Rectangle x:Name="SplitLine" Width="2" Fill="#E6FFFFFF" HorizontalAlignment="Left" Visibility="Hidden"/>
          <Grid x:Name="SplitKnob" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Hidden">
            <Ellipse Fill="#FFF5F5F7">
              <Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.5"/></Ellipse.Effect>
            </Ellipse>
            <Path Data="M9.5,10 L6,15 L9.5,20 M20.5,10 L24,15 L20.5,20" Stroke="#FF1C1C1E" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
          </Grid>

          <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" CornerRadius="8" Background="#B3000000" Padding="8,2">
            <TextBlock Text="Original" FontSize="11" FontWeight="SemiBold" Foreground="#CCFFFFFF"/>
          </Border>
          <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" CornerRadius="8" Background="#B3000000" Padding="8,2">
            <TextBlock Text="OLED" FontSize="11" FontWeight="SemiBold" Foreground="#FFBF5AF2"/>
          </Border>
          <Border x:Name="OffPill" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" CornerRadius="8"
                  Background="#B3000000" Padding="9,3" Visibility="Hidden">
            <TextBlock x:Name="OffText" FontSize="12"/>
          </Border>
          <TextBlock x:Name="LoadingText" Text="Reading frames…" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{StaticResource Sub}" FontSize="13"/>
        </Grid>

        <!-- frames from across the video; click one to preview it -->
        <UniformGrid x:Name="Thumbs" Rows="1" Columns="6" Margin="-3,10,-3,0" Height="57"/>

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="12" Padding="14,8,14,6">
            <StackPanel>
              <TextBlock Text="BLACKS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Sub}" Margin="0,0,0,2"/>
              <Grid Margin="0,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="106"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Black level" FontSize="14" VerticalAlignment="Center" ToolTip="Anything darker than this switches fully off. Set automatically for each video."/>
                <Slider x:Name="BlackSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="60"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center" ToolTip="Anything darker than this switches fully off. Set automatically for each video."/>
                <TextBlock x:Name="BlackVal" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource Sub}"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Line}"/>
              <Grid Margin="0,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="106"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Shadow depth" FontSize="14" VerticalAlignment="Center" ToolTip="How gradually dark areas fade into black. Higher is deeper and moodier; lower keeps more shadow detail."/>
                <Slider x:Name="ShadowSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="1" Maximum="2"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center" ToolTip="How gradually dark areas fade into black. Higher is deeper and moodier; lower keeps more shadow detail."/>
                <TextBlock x:Name="ShadowVal" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource Sub}"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Line}"/>
              <Grid Margin="0,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="106"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Color boost" FontSize="14" VerticalAlignment="Center" ToolTip="Saturation. A little extra makes neon and lights pop against true black."/>
                <Slider x:Name="ColorSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0.8" Maximum="1.5"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center" ToolTip="Saturation. A little extra makes neon and lights pop against true black."/>
                <TextBlock x:Name="ColorVal" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource Sub}"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Line}"/>
              <Grid Margin="0,9,0,7">
                <TextBlock Text="Clean up noise" FontSize="14" VerticalAlignment="Center"
                           ToolTip="Stops compression noise flickering in the blacks. Applied when saving, so it doesn't show in this preview."/>
                <ToggleButton x:Name="CleanSw" Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="12" Padding="14,8,14,6">
            <StackPanel>
              <TextBlock Text="LIGHT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Sub}" Margin="0,0,0,2"/>
              <Grid Margin="0,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="106"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Brightness" FontSize="14" VerticalAlignment="Center" ToolTip="Lifts everything that is lit, without touching true black or clipping whites."/>
                <Slider x:Name="BrightSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center" ToolTip="Lifts everything that is lit, without touching true black or clipping whites."/>
                <TextBlock x:Name="BrightVal" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource Sub}"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Line}"/>
              <Grid Margin="0,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="106"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Highlights" FontSize="14" VerticalAlignment="Center" ToolTip="Pushes the brightest parts (lights, signs, neon) harder. High values can clip them to full brightness."/>
                <Slider x:Name="HighSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center" ToolTip="Pushes the brightest parts (lights, signs, neon) harder. High values can clip them to full brightness."/>
                <TextBlock x:Name="HighVal" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource Sub}"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Line}"/>
              <Grid Margin="0,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="106"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Glow" FontSize="14" VerticalAlignment="Center" ToolTip="Soft bloom around bright areas, like light spilling into the dark. Turns some black pixels back on, so watch the counter."/>
                <Slider x:Name="GlowSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center" ToolTip="Soft bloom around bright areas, like light spilling into the dark. Turns some black pixels back on, so watch the counter."/>
                <TextBlock x:Name="GlowVal" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource Sub}"/>
              </Grid>
              <Border Height="1" Background="{StaticResource Line}"/>
              <Grid Margin="0,7">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="106"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Glow size" FontSize="14" VerticalAlignment="Center" ToolTip="How far the glow spreads."/>
                <Slider x:Name="GlowSizeSlider" Grid.Column="1" Style="{StaticResource ThinSlider}" Minimum="6" Maximum="48"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center" ToolTip="How far the glow spreads."/>
                <TextBlock x:Name="GlowSizeVal" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="13" Foreground="{StaticResource Sub}"/>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <Grid Margin="0,16,0,0">
          <Button x:Name="ResetBtn" Content="Reset to auto" Style="{StaticResource Link}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="Cancel" Style="{StaticResource Pill}" FontSize="14" Margin="0,0,10,0" MinWidth="90"/>
            <Button x:Name="SaveBtn" Content="Save" Style="{StaticResource PrimaryPill}" MinWidth="110" IsDefault="True"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
