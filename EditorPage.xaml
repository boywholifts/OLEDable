<UserControl x:Class="HydroShiftRecorder.EditorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="RowValue" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{DynamicResource Sub}"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="24,0,24,12">
      <DockPanel LastChildFill="True">
        <Button x:Name="BackBtn" DockPanel.Dock="Left" Style="{StaticResource GhostBtn}" Padding="6,0,12,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Path Style="{StaticResource Icon}" Width="16" Height="16" Data="M15,5 L8,12 L15,19"/>
            <TextBlock Text="Library" Margin="6,0,0,0" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Border DockPanel.Dock="Left" Width="1" Height="26" Background="{DynamicResource Line2}" Margin="8,0,16,0"/>
        <Button x:Name="ExportBtn" DockPanel.Dock="Right" Content="Export" Style="{StaticResource PrimaryPill}" Padding="24,0" Margin="10,0,0,0"
                ToolTip="Render the finished video into your library"/>
        <Button x:Name="ResetBtn" DockPanel.Dock="Right" Content="Reset to auto" Style="{StaticResource GhostBtn}"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="MetaText" FontSize="12" Foreground="{DynamicResource Sub}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="340"/>
      </Grid.ColumnDefinitions>

      <!-- preview + timeline -->
      <Grid x:Name="Left" Margin="24,20,24,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border x:Name="PreviewFrame" CornerRadius="14" Background="Black" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                VerticalAlignment="Top" HorizontalAlignment="Center" ClipToBounds="True">
          <Grid x:Name="PreviewHost" Background="Black" Cursor="SizeWE"
                ToolTip="Drag to compare the original (left) with the OLED version (right)">
            <Image x:Name="OledImg" Stretch="Fill"/>
            <Image x:Name="OrigImg" Stretch="Fill"/>
            <Rectangle x:Name="SplitLine" Width="2" Fill="#E6FFFFFF" HorizontalAlignment="Left" Visibility="Hidden"/>
            <Grid x:Name="SplitKnob" Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Hidden">
              <Ellipse Fill="#FFF2F2F5"/>
              <Path Data="M10,11 L5,16 L10,21 M22,11 L27,16 L22,21" Stroke="#FF111111" StrokeThickness="2" StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            </Grid>
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" CornerRadius="6" Background="#BF000000" Padding="9,3">
              <TextBlock Text="Original" FontSize="12" FontWeight="SemiBold" Foreground="#FFD6D6DE"/>
            </Border>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" CornerRadius="6" Background="#BF000000" Padding="9,3">
              <TextBlock Text="OLED" FontSize="12" FontWeight="SemiBold" Foreground="#FFC9A6FF"/>
            </Border>
            <!-- AI enhance working on the preview -->
            <Border x:Name="EnhPill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12" CornerRadius="6" Background="#D9000000"
                    Padding="12,6" Visibility="Collapsed">
              <StackPanel>
                <TextBlock x:Name="EnhPillText" Text="AI enhancing the preview…" FontSize="12" Foreground="#FFF2F2F5" HorizontalAlignment="Center"/>
                <ProgressBar Style="{StaticResource Thin}" IsIndeterminate="True" Width="160" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
            <Border x:Name="OffPill" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" CornerRadius="6" Background="#BF000000"
                    Padding="10,4" Visibility="Hidden">
              <TextBlock x:Name="OffText" FontSize="12" Foreground="#FFF2F2F5"/>
            </Border>
            <TextBlock x:Name="LoadingText" Text="Reading frames…" Foreground="#FF9E9E9E" FontSize="13"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Border>

        <!-- filmstrip with trim handles (hidden for still images) -->
        <Grid x:Name="StripRow" Grid.Row="1" Margin="0,16,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border CornerRadius="8" Background="Black" ClipToBounds="True" Height="58">
            <Grid x:Name="Strip" Background="Transparent">
              <UniformGrid x:Name="Thumbs" Rows="1" Columns="8" IsHitTestVisible="False"/>
              <!-- the shading and the playhead ignore the mouse: the strip itself scrubs; only the handles take clicks -->
              <Canvas x:Name="TrimLayer" ClipToBounds="True">
                <Rectangle x:Name="DimL" Fill="#B3000000" Height="58" IsHitTestVisible="False"/>
                <Rectangle x:Name="DimR" Fill="#B3000000" Height="58" IsHitTestVisible="False"/>
                <!-- playhead: the frame in the preview -->
                <Grid x:Name="SelMark" Width="12" Height="58" IsHitTestVisible="False">
                  <Grid.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8"/></Grid.Effect>
                  <Rectangle Width="2" Fill="White" HorizontalAlignment="Center"/>
                  <Border Width="12" Height="6" CornerRadius="0,0,6,6" Background="White" VerticalAlignment="Top"/>
                  <Border Width="12" Height="6" CornerRadius="6,6,0,0" Background="White" VerticalAlignment="Bottom"/>
                </Grid>
                <Border x:Name="HandleL" Width="10" Height="58" Background="{DynamicResource Accent}" CornerRadius="8,0,0,8" Cursor="SizeWE"
                        ToolTip="Drag to choose where the clip starts">
                  <Rectangle Width="2" Height="18" Fill="#99FFFFFF" RadiusX="1" RadiusY="1"/>
                </Border>
                <Border x:Name="HandleR" Width="10" Height="58" Background="{DynamicResource Accent}" CornerRadius="0,8,8,0" Cursor="SizeWE"
                        ToolTip="Drag to choose where the clip ends">
                  <Rectangle Width="2" Height="18" Fill="#99FFFFFF" RadiusX="1" RadiusY="1"/>
                </Border>
              </Canvas>
            </Grid>
          </Border>
        </Grid>
        <DockPanel x:Name="TrimRow" Grid.Row="2" Margin="0,10,0,0">
          <TextBlock x:Name="TrimText" DockPanel.Dock="Right" FontSize="12" Foreground="{DynamicResource Sub}"/>
          <TextBlock Text="Click or drag along the filmstrip to pick a frame (← → step one)  ·  drag the handles to trim  ·  drag the picture to compare"
                     FontSize="12" Foreground="{DynamicResource Sub}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
      </Grid>

      <!-- inspector -->
      <Border Grid.Column="1" Background="{DynamicResource Side}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
          <StackPanel Margin="22,20,22,24">

            <TextBlock Text="NAME" Style="{StaticResource SectionTitle}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource Field}"/>
            <TextBlock x:Name="SaveAsText" FontSize="12" Foreground="{DynamicResource Sub}" Margin="0,6,0,22" TextWrapping="Wrap"/>

            <TextBlock Text="OUTPUT" Style="{StaticResource SectionTitle}"/>
            <WrapPanel x:Name="OutChips">
              <RadioButton x:Name="OutPanel" Content="HydroShift" GroupName="outm" Style="{StaticResource Chip}" Margin="0,0,6,6"
                           ToolTip="2288 × 1048, cropped to fill the HydroShift. Kept under L-Connect's 30 MB upload limit."/>
              <RadioButton x:Name="OutOrig" Content="Original size" GroupName="outm" Style="{StaticResource Chip}" Margin="0,0,6,6"
                           ToolTip="Keeps the source's own size and shape: nothing is cropped or resized."/>
              <RadioButton x:Name="OutUp" Content="Upscale" GroupName="outm" Style="{StaticResource Chip}" Margin="0,0,6,6"
                           ToolTip="Keeps the shape, 2× or 4× larger. Best with AI enhance on."/>
              <RadioButton x:Name="OutCustom" Content="Custom" GroupName="outm" Style="{StaticResource Chip}" Margin="0,0,6,6"
                           ToolTip="Fills a size you choose (cropping to fit), e.g. 4K or a phone screen."/>
            </WrapPanel>
            <Border x:Name="UpRow" Visibility="Collapsed" HorizontalAlignment="Left" Background="{DynamicResource Bg}" CornerRadius="9" Padding="2" Margin="0,4,0,0">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Up2" Content="2×" GroupName="upf" Style="{StaticResource Seg}"/>
                <RadioButton x:Name="Up4" Content="4×" GroupName="upf" Style="{StaticResource Seg}"/>
              </StackPanel>
            </Border>
            <StackPanel x:Name="CustomRow" Visibility="Collapsed" Margin="0,4,0,0">
              <WrapPanel x:Name="PresetChips"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBox x:Name="CustomWBox" Style="{StaticResource Field}" Width="90" ToolTip="Width in pixels"/>
                <TextBlock Text="×" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource Sub}"/>
                <TextBox x:Name="CustomHBox" Style="{StaticResource Field}" Width="90" ToolTip="Height in pixels"/>
              </StackPanel>
            </StackPanel>
            <TextBlock x:Name="OutNote" FontSize="12" Foreground="{DynamicResource Sub}" Margin="0,8,0,22" TextWrapping="Wrap"/>

            <TextBlock Text="TRUE BLACK" Style="{StaticResource SectionTitle}"/>
            <DockPanel><TextBlock x:Name="BlackVal" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
              <TextBlock Text="Black level" Style="{StaticResource RowLabel}" ToolTip="Anything darker than this switches fully off. Set automatically for each video."/></DockPanel>
            <Slider x:Name="BlackSlider" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="60" Margin="0,4,0,14"/>
            <DockPanel><TextBlock x:Name="ShadowVal" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
              <TextBlock Text="Shadow depth" Style="{StaticResource RowLabel}" ToolTip="How gradually dark areas fade into black. Higher is deeper; lower keeps more shadow detail."/></DockPanel>
            <Slider x:Name="ShadowSlider" Style="{StaticResource ThinSlider}" Minimum="1" Maximum="2" Margin="0,4,0,14"/>
            <DockPanel><TextBlock x:Name="ColorVal" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
              <TextBlock Text="Color boost" Style="{StaticResource RowLabel}" ToolTip="Saturation. A little extra makes neon and lights pop against true black."/></DockPanel>
            <Slider x:Name="ColorSlider" Style="{StaticResource ThinSlider}" Minimum="0.8" Maximum="1.5" Margin="0,4,0,14"/>
            <DockPanel x:Name="CleanRow" Margin="0,0,0,24">
              <ToggleButton x:Name="CleanSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel>
                <TextBlock Text="Clean up noise" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="Stops flicker in the blacks (applied on export)" FontSize="12" Foreground="{DynamicResource Sub}" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>

            <TextBlock Text="LIGHT" Style="{StaticResource SectionTitle}"/>
            <DockPanel><TextBlock x:Name="BrightVal" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
              <TextBlock Text="Brightness" Style="{StaticResource RowLabel}" ToolTip="Lifts everything that is lit, without touching true black or clipping whites."/></DockPanel>
            <Slider x:Name="BrightSlider" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1" Margin="0,4,0,14"/>
            <DockPanel><TextBlock x:Name="HighVal" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
              <TextBlock Text="Highlights" Style="{StaticResource RowLabel}" ToolTip="Pushes the brightest parts (lights, signs, neon) harder."/></DockPanel>
            <Slider x:Name="HighSlider" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1" Margin="0,4,0,14"/>
            <DockPanel><TextBlock x:Name="GlowVal" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
              <TextBlock Text="Glow" Style="{StaticResource RowLabel}" ToolTip="Soft bloom around bright areas. Turns some black pixels back on, so watch the counter."/></DockPanel>
            <Slider x:Name="GlowSlider" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1" Margin="0,4,0,14"/>
            <DockPanel x:Name="GlowSizeRow"><TextBlock x:Name="GlowSizeVal" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
              <TextBlock Text="Glow size" Style="{StaticResource RowLabel}"/></DockPanel>
            <Slider x:Name="GlowSizeSlider" Style="{StaticResource ThinSlider}" Minimum="6" Maximum="48" Margin="0,4,0,24"/>

            <TextBlock Text="DETAIL" Style="{StaticResource SectionTitle}"/>
            <DockPanel x:Name="EnhanceRow" Margin="0,0,0,14">
              <ToggleButton x:Name="EnhanceSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel>
                <TextBlock Text="AI enhance" Style="{StaticResource RowLabel}"
                           ToolTip="Real-ESRGAN redraws the video at a higher resolution, then fits it to the panel: sharper edges and text, not just more contrast. Runs on your graphics card."/>
                <TextBlock x:Name="EnhanceNote" FontSize="12" Foreground="{DynamicResource Sub}" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
            <!-- options, shown while AI enhance is on -->
            <StackPanel x:Name="EnhanceOpts" Margin="0,0,0,24" Visibility="Collapsed">
              <TextBlock Text="Style" Style="{StaticResource RowLabel}"/>
              <WrapPanel x:Name="StyleChips" Margin="0,8,0,14"/>
              <DockPanel><TextBlock x:Name="StrengthVal" DockPanel.Dock="Right" Style="{StaticResource RowValue}"/>
                <TextBlock Text="Strength" Style="{StaticResource RowLabel}"
                           ToolTip="How much of the AI result is used, mixed with a plain upscale. Lower it if things look painted or waxy."/></DockPanel>
              <Slider x:Name="StrengthSlider" Style="{StaticResource ThinSlider}" Minimum="0" Maximum="1" Margin="0,4,0,14"/>
              <DockPanel Margin="0,0,0,12">
                <ToggleButton x:Name="CleanFirstSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                <StackPanel>
                  <TextBlock Text="Clean up first" Style="{StaticResource RowLabel}"/>
                  <TextBlock Text="Smooths out compression blocks and grain so they aren't sharpened into fake detail" FontSize="12"
                             Foreground="{DynamicResource Sub}" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
              <Button x:Name="MoreBtn" Content="More options" Style="{StaticResource Link}" HorizontalAlignment="Left"/>
              <StackPanel x:Name="MorePanel" Visibility="Collapsed" Margin="0,12,0,0">
                <DockPanel Margin="0,0,0,12">
                  <ToggleButton x:Name="TtaSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="Quality mode" Style="{StaticResource RowLabel}"/>
                    <TextBlock Text="Slightly cleaner edges, about 8× slower" FontSize="12" Foreground="{DynamicResource Sub}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
                <DockPanel Margin="0,0,0,12">
                  <ToggleButton x:Name="SharpenSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="Sharpen a little" Style="{StaticResource RowLabel}"/>
                    <TextBlock Text="A light sharpening pass after the upscale (export only)" FontSize="12" Foreground="{DynamicResource Sub}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DockPanel>
                <TextBlock FontSize="12" Foreground="{DynamicResource Sub}" TextWrapping="Wrap">
                  Add community models (ncnn .param + .bin, e.g. the ones Upscayl uses) to the models folder and they appear as styles.
                </TextBlock>
                <Button x:Name="ModelsBtn" Content="Open the models folder" Style="{StaticResource Link}" HorizontalAlignment="Left" Margin="0,6,0,0"/>
              </StackPanel>
            </StackPanel>

            <TextBlock x:Name="MotionTitle" Text="MOTION" Style="{StaticResource SectionTitle}"/>
            <DockPanel x:Name="LoopRow" Margin="0,0,0,14">
              <ToggleButton x:Name="LoopSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel>
                <TextBlock Text="Seamless loop" Style="{StaticResource RowLabel}"/>
                <TextBlock Text="Crossfades the end into the start" FontSize="12" Foreground="{DynamicResource Sub}"/>
              </StackPanel>
            </DockPanel>
            <DockPanel x:Name="SmoothRow">
              <ToggleButton x:Name="SmoothSw" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel>
                <TextBlock Text="Smooth to 60 fps" Style="{StaticResource RowLabel}"/>
                <TextBlock x:Name="SmoothNote" FontSize="12" Foreground="{DynamicResource Sub}" TextWrapping="Wrap"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</UserControl>
